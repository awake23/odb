load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

string_flag(
    name = "threading",
    build_setting_default = "cxx11",
    values = ["none", "cxx11"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "threading_none",
    flag_values = {":threading": "none"},
)

cc_library(
    name = "libodb",
    srcs = glob(
        include = ["odb/**/*.cxx"],
        exclude = [
            "odb/details/condition.cxx",
            "odb/details/lock.cxx",
            "odb/details/mutex.cxx",
        ],
    ),
    hdrs = glob(
        include = [
            "odb/**/*.h",
            "odb/**/*.hxx",
            "odb/**/*.ixx",
            "odb/**/*.txx",
        ],
        exclude = [
            "odb/details/config-vc.h",
            "odb/details/win32/**",
        ],
    ),
    defines = ["LIBODB_STATIC"] + select({
        ":threading_none": ["ODB_THREADS_NONE"],
        "//conditions:default": [],
    }),
    local_defines = ["LIBODB_STATIC_BUILD"],
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)
